---
import { projects } from '../data/projects';
import ProjectRow from './ProjectRow.astro';
---

<section id="projects" class="scroll-section scroll-reveal">
  <div class="projects-container">
    <div class="section-title-line">
      <span class="section-tag">// portafolio</span>
      <h2>Proyectos Destacados</h2>
      <div class="title-line"></div>
    </div>

    <p class="section-intro">Ideas llevadas a código. Explora las decisiones, los retos y las tecnologías de cada proyecto.</p>
    <div class="project-tools" hidden>
      <label for="project-search">Encuentra un proyecto</label>
      <input id="project-search" type="search" placeholder="Busca por nombre o tecnología…" aria-controls="project-list" />
      <p id="project-count" role="status" aria-live="polite"></p>
    </div>
    <p id="project-empty" hidden>No encontré proyectos con esa búsqueda. Prueba con Python, Java o React.</p>
    <div class="projects-rows-list" id="project-list">
      {projects.map(project => (
        <ProjectRow project={project} />
      ))}
    </div>
  </div>
</section>
