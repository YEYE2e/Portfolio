---
import type { Project } from '../types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="project-row-item" data-project-id={project.id} tabindex="0" role="button" aria-expanded="false">
  <div class="row-header">
    <span class="project-num">{project.number}</span>
    <h3 transition:name={`project-title-${project.id}`}>{project.title}</h3>

    <div class="row-header-meta">
      <span class="project-cat">{project.category}</span>
      {project.repo && (
        <a
          href={project.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="project-gh-pill"
          title={`Ver código de ${project.title} en GitHub`}
          aria-label={`Ver repositorio de ${project.title} en GitHub`}
        >
          <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>GitHub ↗</span>
        </a>
      )}
    </div>
  </div>

  <!-- Recuadro de Detalles Rápidos -->
  <div class="row-details">
    <div class="row-details-inner">
      <div class="project-quick-box">
        <!-- Metadata Header -->
        <div class="quick-meta-bar">
          <span class="meta-item"><span class="meta-tag">ROL:</span> {project.role}</span>
          <span class="meta-item"><span class="meta-tag">AÑO:</span> {project.year}</span>
        </div>

        <!-- Description -->
        <p class="quick-desc">{project.description}</p>

        <!-- Technical Highlights Grid -->
        <div class="quick-highlights-grid">
          {project.architecture && project.architecture.length > 0 && (
            <div class="quick-col">
              <h4 class="quick-col-header">// ARQUITECTURA &amp; DISEÑO</h4>
              <ul class="quick-points-list">
                {project.architecture.slice(0, 3).map(point => (
                  <li>
                    <span class="point-bullet">▹</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {project.results && project.results.length > 0 && (
            <div class="quick-col">
              <h4 class="quick-col-header">// RESULTADOS &amp; MÉTRICAS</h4>
              <ul class="quick-points-list">
                {project.results.slice(0, 3).map(point => (
                  <li>
                    <span class="point-bullet-green">✓</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Stack Tecnológico -->
        <div class="project-tech-list">
          {project.tags.map(tag => (
            <span class="tech-badge">{tag}</span>
          ))}
        </div>

        <!-- Quick Action Buttons -->
        <div class="quick-actions-bar">
          {project.repo && (
            <a
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-quick-gh"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Abrir en GitHub ↗</span>
            </a>
          )}
          <a href={`${baseUrl}/projects/${project.id}`} class="btn-quick-case">
            Caso de Estudio Completo <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="row-divider-line"></div>
</div>
